# Copy to .env (the app auto-loads it). Without CR_API_TOKEN the app runs in MOCK mode
# with realistic simulated data so you can see it working immediately.
#
# Get a token: https://developer.clashroyale.com  ->  create an API key  ->
# whitelist the PUBLIC IP of the machine running this server (curl https://ifconfig.me).
CR_API_TOKEN=

PORT=3000
WINDOW_MINUTES=5          # default "recent" window shown
LEADERBOARD_LIMIT=1000    # how many top players to track (max the UI lets you monitor)
LEADERBOARD_REFRESH_MS=300000   # re-fetch the leaderboard every 5 min
POLL_CONCURRENCY=6        # parallel battlelog fetches; ~6 stays under the API throttle at 1000 players (raise for fewer players / faster sweeps)
POLL_CYCLE_DELAY_MS=1000  # pause between full battlelog sweeps
# CR_MAX_RETRIES=4        # retries on 429/5xx before giving up (default 4)
# CR_RETRY_BASE_MS=300    # backoff base in ms (default 300; exp + jitter)
